# ---- База данных ----
# Форматы: pgsql://user:pass@host:5432/dbname | mysql://user:pass@host:3306/dbname | sqlite:////absolute/path.db
DATABASE_URL=pgsql://app:app_secret@db:5432/products

# ---- JWT-аутентификация ----
# Секрет подписи токена (минимум 32 символа). ОБЯЗАТЕЛЬНО заменить в проде.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Время жизни токена в секундах
JWT_TTL=3600
# Админ-пользователь, создаваемый сидером
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Администратор

# ---- Очередь импорта (Symfony Messenger) ----
# amqp://guest:guest@rabbitmq:5672/%2f/messages — асинхронно через RabbitMQ (docker)
# sync:// — синхронное выполнение (локальная разработка и тесты, ext-amqp не нужен)
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages

# ---- Хранилище изображений ----
# Каталог, куда скачиваются изображения (в docker — общий volume /var/www/storage)
IMAGE_STORAGE_PATH=/var/www/storage
# Максимальный размер одного изображения, байт
IMAGE_MAX_BYTES=10485760
# Таймаут скачивания изображения, секунды
IMAGE_DOWNLOAD_TIMEOUT=15

# ---- Загрузка файлов импорта ----
# Максимальный размер .xlsx, байт
UPLOAD_MAX_BYTES=20971520

# ---- Rate limiting на POST /api/import ----
# Максимум запросов на IP за период
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_PERIOD_SECONDS=60

# ---- Порты (docker compose) ----
HTTP_PORT=80
