{
    "name": "test-task/products-import",
    "description": "Import/export products: Slim + Doctrine + Angular + RabbitMQ",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.3",
        "firebase/php-jwt": "^6.11",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.8",
        "php-di/php-di": "^7.0",
        "phpoffice/phpspreadsheet": "^3.9",
        "respect/validation": "^2.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/amqp-messenger": "^7.2",
        "symfony/cache": "^7.2",
        "symfony/console": "^7.2",
        "symfony/messenger": "^7.2",        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff"
    }
}
